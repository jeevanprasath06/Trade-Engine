# Keep this on testnet until you have completed a real test order.
HL_NETWORK=testnet

# Never commit this file. Use a dedicated trading wallet with limited funds.
HL_WALLET_PRIVATE_KEY=

# Execution has two independent gates: this value and the --execute CLI option.
HL_EXECUTION_ENABLED=false

# Guardrails (USD values)
HL_MAX_ORDER_NOTIONAL_USD=25
HL_MAX_POSITION_NOTIONAL_USD=100
HL_ALLOWED_COINS=BTC,ETH,SOL
HL_MAX_SLIPPAGE=0.01
HL_CANCEL_AFTER_SECONDS=30
